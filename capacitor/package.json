{
  "name": "suechef-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Sue Chef — Capacitor iOS wrap. www/ is generated by ../app/build.sh; never edit it by hand.",
  "scripts": {
    "build:www": "bash ../app/build.sh",
    "sync": "npm run build:www && npx cap sync ios",
    "open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}
